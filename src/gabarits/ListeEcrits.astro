---
/** Liste des écrits (Figma 9:1861) : entrées sans retrait, conteneur de 1 120 px. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Carte from '../components/molecules/Carte.astro';
import EnTete from '../components/molecules/EnTete.astro';
import Planche from '../components/organismes/Planche.astro';
import { otherLocale, path, type Locale } from '../i18n/routes';
import { getInterface } from '../i18n/ui';
import { carteDEcrit } from '../lib/cartes';
import { lister } from '../lib/contenu';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = await getInterface(locale);
const ecrits = await lister('ecrits', locale);
---

<BaseLayout title={ui.navigation.ecrits} description={ui.metadonnees.ecrits} locale={locale} noindex={ecrits.length === 0} alternate={path('ecrits', otherLocale(locale))}>
  <div class="container container--etroit page-tete">
    <EnTete titre={ui.navigation.ecrits} niveau={1} espace="page" />
  </div>
  <div class="container container--etroit" data-apparition>
    {
      ecrits.map((e) => (
        <Carte {...carteDEcrit(e, locale, ui)} niveau={2} retrait={false} />
      ))
    }
  </div>
  <Planche titre={ui.planche.titre} texte={ui.planche.texte} />
</BaseLayout>
