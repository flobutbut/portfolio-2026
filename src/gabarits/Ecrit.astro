---
/**
 * Page d'écrit (Figma 28:342, modèle Écrit 07)
 * En-tête · corps · cas cités · limites · écrits liés.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Encart from '../components/atomes/Encart.astro';
import Lien from '../components/atomes/Lien.astro';
import Carte from '../components/molecules/Carte.astro';
import EnTete from '../components/molecules/EnTete.astro';
import Planche from '../components/organismes/Planche.astro';
import { path, type Locale, versionMarkdown } from '../i18n/routes';
import { getInterface } from '../i18n/ui';
import { modeApercu } from '../lib/mode';
import { carteDeCas, carteDEcrit } from '../lib/cartes';
import { resoudre, type Element } from '../lib/contenu';
import { rendreEcrit, rendreTexte } from '../lib/markdown';
import { article } from '../lib/donneesStructurees';

interface Props {
  locale: Locale;
  ecrit: Element<'ecrits'>;
}

const { locale, ecrit } = Astro.props;
const ui = await getInterface(locale);
const t = ui.ecrit;
const d = ecrit.data;
const corps = await rendreEcrit(ecrit.body, ecrit.langue, ecrit.fichier);
const limites = d.limites ? await rendreTexte(d.limites, ecrit.langue, ecrit.fichier) : '';
const casCites = await resoudre('cas', locale, d.casCites);
const ecritsLies = await resoudre('ecrits', locale, d.ecritsLies);
const surtitre = [`${t.surtitre} ${String(ecrit.numero).padStart(2, '0')}`, d.genre, `${d.tempsLecture} ${t.lecture}`]
  .filter(Boolean)
  .join(' · ');
---

<BaseLayout title={d.titre} description={d.these} locale={locale} alternate={ecrit.alternate} markdown={versionMarkdown(ecrit.href)} type="article" donnees={[article({ titre: d.titre, href: ecrit.href, langue: ecrit.langue, date: d.date })]}>
  <article lang={ecrit.langue !== locale ? ecrit.langue : undefined}>
    <header class="container container--etroit page-tete ecrit-tete">
      <p class="text-label libelle">{surtitre}</p>
      <div>
        <EnTete titre={d.titre} niveau={1} espace="page" />
        <div class="ecrit-tete__these">
          <Encart>
          <p class="text-lead">{d.these}</p>
          </Encart>
        </div>
      </div>
      {
        d.date && (
          <p class="text-caption libelle">
            <time datetime={d.date.toISOString().slice(0, 10)}>
              {d.date.toLocaleDateString(locale === 'fr' ? 'fr-FR' : 'en-GB', { day: 'numeric', month: 'long', year: 'numeric' })}
            </time>
          </p>
        )
      }
    </header>

    <div class="container container--etroit ecrit-corps">
      <div class="prose" set:html={corps} />

      {
        casCites.length > 0 && (
          <section class="ecrit-bloc" aria-labelledby="cas-cites">
            <h2 id="cas-cites" class="text-label libelle">{t.casCite}</h2>
            {casCites.map((c) => (
              <Carte {...carteDeCas(c, locale, ui, c.data.visuel ?? (modeApercu ? { alt: '' } : undefined))} />
            ))}
          </section>
        )
      }

      {
        limites && (
          <section class="ecrit-bloc prose" aria-labelledby="limites">
            <h2 id="limites" class="text-heading-24">{t.limites}</h2>
            <Fragment set:html={limites} />
          </section>
        )
      }

      <nav class="ecrit-bloc ecrits-lies" aria-labelledby="ecrits-lies">
        {
          ecritsLies.length > 0 && (
            <>
              <h2 id="ecrits-lies" class="text-label libelle">{t.ecritsLies}</h2>
              <div>
                {ecritsLies.map((e) => (
                  <Carte {...carteDEcrit(e, locale, ui)} retrait={false} />
                ))}
              </div>
            </>
          )
        }
        <Lien texte="text-ui" href={path('ecrits', locale)}>{t.tousLesEcrits}</Lien>
      </nav>
    </div>
  </article>
  <Planche libelle={ui.planche.libelle} titre={ui.planche.titre} texte={ui.planche.texte} />
</BaseLayout>

<style>
  /* En-tête d'écrit : ≈ 264 px au-dessus (Figma 28:344) ; l'encart de la thèse ferme l'en-tête */
  .ecrit-tete {
    display: flex;
    flex-direction: column;
    gap: var(--space-24);
    padding-top: min(var(--layout-page-tete), var(--layout-ecrit-tete));
  }

  /* Même en-tête que les cas : En-tête de section (variante page), thèse dans un encart */
  .ecrit-tete__these p {
    max-width: 47.5rem;
  }

  .ecrit-corps {
    display: flex;
    flex-direction: column;
    gap: var(--space-56);
    padding-top: var(--space-56);
    padding-bottom: var(--space-32);
  }

  .ecrit-bloc {
    display: flex;
    flex-direction: column;
    gap: var(--space-20);
  }

  .ecrits-lies {
    padding-top: var(--space-24);
    border-top: 1px solid var(--color-border-ink);
  }
</style>
