---
/** Liste des travaux (Figma 9:1314) : entrées avec visuel, conteneur de 1 120 px. */
import BaseLayout from '../layouts/BaseLayout.astro';
import Carte from '../components/molecules/Carte.astro';
import EnTete from '../components/molecules/EnTete.astro';
import Planche from '../components/organismes/Planche.astro';
import { otherLocale, path, type Locale } from '../i18n/routes';
import { getInterface } from '../i18n/ui';
import { modeApercu } from '../lib/mode';
import { carteDeCas } from '../lib/cartes';
import { lister } from '../lib/contenu';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = await getInterface(locale);
const cas = await lister('cas', locale);
---

<BaseLayout title={ui.navigation.travaux} description={ui.metadonnees.travaux} locale={locale} noindex={cas.length === 0} alternate={path('travaux', otherLocale(locale))}>
  <div class="container container--etroit page-tete">
    <EnTete titre={ui.navigation.travaux} niveau={1} espace="page" />
  </div>
  <div class="container container--etroit liste" data-apparition>
    {
      cas.map((c) => (
        <Carte {...carteDeCas(c, locale, ui, c.data.visuel ?? (modeApercu ? { alt: '' } : undefined))} niveau={2} />
      ))
    }
  </div>
  <Planche titre={ui.planche.titre} texte={ui.planche.texte} />
</BaseLayout>

<style>
  .liste {
    padding-top: var(--space-8);
  }
</style>
