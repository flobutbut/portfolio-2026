---
/**
 * Figures de la méthode (Fig. 04, 05, 06 ; Figma 119:8515) : illustration sur fond gris, et sa légende.
 * L'image est placée dans public/ et déclarée dans content/<langue>/accueil.yaml.
 * Le cadre a des proportions fixes : les trois figures se remplacent sans que la mise en page bouge.
 * L'illustration est décorative ; la légende la décrit.
 */
interface Props {
  src: string;
  legende: string;
}

const { src, legende } = Astro.props;
---

<figure class="fig-methode">
  <div class="fig-methode__cadre">
    <img src={src} alt="" loading="lazy" decoding="async" />
  </div>
  <figcaption class="text-caption fig-methode__legende">{legende}</figcaption>
</figure>

<style>
  .fig-methode {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .fig-methode__cadre {
    display: grid;
    place-items: center;
    aspect-ratio: 676 / 578;
    padding: 2rem;
    background: var(--color-background-subtle);
  }

  .fig-methode__cadre img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .fig-methode__legende {
    color: var(--color-text-muted);
  }
</style>
