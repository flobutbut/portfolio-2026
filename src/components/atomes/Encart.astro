---
/**
 * Atome · Encart : texte d'introduction sur fond background/subtle
 * (accroche des cas, thèse des écrits, introduction des strates).
 */
---

<div class="encart"><slot /></div>

<style>
  .encart {
    padding: var(--space-24) var(--space-32);
    background: var(--color-background-subtle);
  }

  @media (max-width: 39.99rem) {
    .encart {
      padding: var(--space-20);
    }
  }
</style>
