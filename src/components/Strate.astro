---
/**
 * Strates/Strate (Figma 2:494)
 * Bandeau d'étiquette. On : aplat bleu, texte blanc atténué. Off : neutres.
 * L'état est aussi donné en texte aux technologies d'assistance (`etatTexte`).
 */
interface Props {
  etat?: boolean;
  /** Texte lu après le libellé, par exemple « touchée » ou « non touchée ». */
  etatTexte?: string;
}

const { etat = true, etatTexte } = Astro.props;
---

<span class:list={['strate', 'text-caption', etat ? 'strate--on' : 'strate--off']}>
  <slot />{etatTexte && <span class="visually-hidden"> ({etatTexte})</span>}
</span>

<style>
  .strate {
    display: block;
    /* 6 + 16 + 6 = 28 px de haut */
    padding: 0.375rem 0.5rem;
    line-height: 1rem;
    white-space: nowrap;
  }

  .strate--on {
    background: var(--color-background-brand);
    color: var(--color-text-on-brand-muted);
  }

  .strate--off {
    background: var(--color-surface-inactive);
    /* text/supporting : contraste AA sur surface/inactive (5,4:1) */
    color: var(--color-text-supporting);
  }
</style>
