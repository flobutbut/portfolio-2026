---
/**
 * Strates/Navigation (Figma 2:487)
 * Logo, liens de section (dont la page Contact) et lien vers l'autre langue.
 * États d'un lien (Figma 7:373, 8:443, 7:406) : repos, survol (aplat bleu), actif (barre de 8 px).
 *
 * Mobile : menu burger construit sur l'API Popover native.
 * Ouverture, fermeture, Échap et clic extérieur fonctionnent sans JavaScript.
 */
import { otherLocale, path, type Locale } from '../i18n/routes';
import { getInterface } from '../i18n/ui';

interface Props {
  locale: Locale;
  /** Adresse de la page équivalente dans l'autre langue, si elle existe. */
  alternate?: string;
}

const { locale, alternate } = Astro.props;
const ui = await getInterface(locale);
const current = Astro.url.pathname.replace(/\/$/, '') || '/';

const sections = (['travaux', 'ecrits', 'parcours', 'contact'] as const).map((key) => {
  const href = path(key, locale);
  const ariaCurrent: 'page' | 'true' | undefined =
    current === href ? 'page' : current.startsWith(`${href}/`) ? 'true' : undefined;
  return { href, label: ui.navigation[key], ariaCurrent };
});

const accueil = path('accueil', locale);
const target = otherLocale(locale);
---

<header class="navigation">
  <div class="navigation__inner container">
    <a class="navigation__logo text-heading-24" href={path('accueil', locale)}>FB.<span class="visually-hidden"> {ui.navigation.accueil}</span></a>

    <button class="navigation__burger" type="button" popovertarget="menu-principal" aria-label={ui.navigation.ouvrirMenu}>
      <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M2 7h20M2 17h20" stroke="currentColor" stroke-width="2"></path>
      </svg>
    </button>

    <nav class="navigation__nav" aria-label={ui.navigation.libelle}>
      <div id="menu-principal" class="navigation__menu" popover>
        <div class="navigation__menu-tete container">
          <a class="navigation__logo text-heading-24" href={path('accueil', locale)}>FB.<span class="visually-hidden"> {ui.navigation.accueil}</span></a>
          <button
            class="navigation__burger"
            type="button"
            popovertarget="menu-principal"
            popovertargetaction="hide"
            aria-label={ui.navigation.fermerMenu}
          >
            <svg width="24" height="24" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 5l14 14M19 5L5 19" stroke="currentColor" stroke-width="2"></path>
            </svg>
          </button>
        </div>

        <ul class="navigation__list" role="list">
          <li class="navigation__item-accueil">
            <a class="navigation__link" href={accueil} aria-current={current === accueil ? 'page' : undefined}>
              {ui.navigation.accueilMenu}
            </a>
          </li>
          {
            sections.map(({ href, label, ariaCurrent }) => (
              <li>
                <a class="navigation__link" href={href} aria-current={ariaCurrent}>
                  {label}
                </a>
              </li>
            ))
          }
          {
            alternate && (
              <li class="navigation__langue">
                <a
                  class="navigation__link"
                  href={alternate}
                  hreflang={target}
                  lang={target}
                  data-lang-switch={target}
                >
                  {ui.langue.code}<span class="visually-hidden"> — {ui.langue.libelle}</span>
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </nav>
  </div>
</header>

<script>
  // Referme le menu mobile quand on suit un lien.
  const menu = document.getElementById('menu-principal');
  menu?.addEventListener('click', (event) => {
    const link = (event.target as Element).closest('a');
    if (!link || !menu.matches(':popover-open')) return;
    menu.hidePopover();
    // Une ancre suivie pendant la fermeture du popover ne défile pas : on défile après.
    const hash = link.getAttribute('href');
    if (hash?.startsWith('#')) {
      event.preventDefault();
      history.pushState(null, '', hash);
      document.querySelector(hash)?.scrollIntoView();
    }
  });
</script>

<style>
  .navigation__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: var(--layout-nav-height);
  }

  .navigation__logo {
    text-decoration: none;
  }

  .navigation__list {
    display: flex;
    padding: 0;
    list-style: none;
  }

  .navigation__list li {
    display: flex;
  }

  .navigation__link {
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: center;
    text-decoration: none;
    transition: color var(--motion-duration) var(--motion-ease);
  }

  /* Barre bleue : absente au repos, 8 px sur la page active, pleine hauteur au survol */
  .navigation__link::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset-inline: 0;
    top: 0;
    height: 0;
    background: var(--color-background-brand);
    transition: height var(--motion-duration) var(--motion-ease);
  }

  .navigation__link[aria-current]::before {
    height: 0.5rem;
  }

  .navigation__burger {
    display: grid;
    place-items: center;
    width: 3rem;
    height: 3rem;
    margin-left: auto;
    margin-right: -0.75rem;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  /* Desktop et tablette : liens en ligne, le popover reste dans le flux */
  @media (min-width: 40rem) {
    .navigation__nav {
      align-self: stretch;
    }

    /* « Accueil » n'existe que dans le menu mobile : sur desktop, le logo suffit (maquette) */
    .navigation__burger,
    .navigation__menu-tete,
    .navigation__list .navigation__item-accueil {
      display: none;
    }

    .navigation__menu {
      display: block;
      position: static;
      inset: auto;
      width: auto;
      height: 100%;
      margin: 0;
      padding: 0;
      border: 0;
      overflow: visible;
      background: none;
      color: inherit;
    }

    .navigation__list {
      height: 100%;
      gap: 2.5rem;
    }

    .navigation__link {
      padding-block: 1.5rem;
      font-size: var(--text-ui-size);
      line-height: var(--text-ui-leading);
      font-weight: 500;
    }

    @media (hover: hover) {
      .navigation__link:hover {
        color: var(--color-text-inverse);
      }

      .navigation__link:hover::before {
        height: 100%;
      }
    }
  }

  /* Mobile : panneau plein écran, liens empilés en Heading/40 */
  @media (max-width: 39.99rem) {
    .navigation__menu:popover-open {
      display: flex;
      flex-direction: column;
      position: fixed;
      inset: 0;
      width: 100%;
      max-width: none;
      height: 100dvh;
      max-height: none;
      margin: 0;
      padding: 0;
      border: 0;
      overflow-y: auto;
      background: var(--color-background-canvas);
      color: var(--color-text-primary);
    }

    .navigation__menu::backdrop {
      background: none;
    }

    .navigation__menu-tete {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: var(--layout-nav-height);
    }

    .navigation__list {
      flex-direction: column;
      padding-inline: var(--layout-gutter);
      padding-bottom: 2rem;
    }

    .navigation__list li {
      border-top: 1px solid var(--color-border-default);
    }

    .navigation__link {
      flex: 1;
      padding-block: 1.25rem;
      font-family: var(--font-heading);
      font-weight: 800;
      font-size: var(--text-heading-40-size);
      line-height: var(--text-heading-leading);
      letter-spacing: var(--text-heading-tracking);
    }

    .navigation__langue .navigation__link {
      font-family: var(--font-body);
      font-weight: 500;
      font-size: var(--text-ui-size);
      line-height: var(--text-ui-leading);
      letter-spacing: 0;
    }
  }
</style>
