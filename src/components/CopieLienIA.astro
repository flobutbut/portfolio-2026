---
/**
 * Bouton « Copier le lien IA » : copie un prompt prêt à coller dans un assistant IA,
 * qui contient l'adresse de la version agent du site (suivie de ?src=prompt pour distinguer ces visites).
 * Rien n'est copié sans que le texte ait été montré :
 * - avec survol : infobulle au survol et au focus clavier (Figma 111:5507), placée au-dessus du bouton
 *   si la place manque en dessous ; le clic copie ;
 * - sans survol (écran tactile) : le toucher ouvre une modale du même style, qui demande confirmation.
 * Après la copie, un message confirme et dit quoi en faire.
 * Sans JavaScript ou sans presse-papiers, le bouton n'existe pas : le lien « Lire la version agent » suffit.
 * Utilisé dans le hero et dans le bloc « Pour les agents » de l'accueil.
 * La rangée de boutons qui le contient doit être positionnée (position: relative) : sous 64rem,
 * les boutons peuvent passer à la ligne et le message se place sous toute la rangée.
 */
import Bouton from './Bouton.astro';
import { fichiersAgents } from '../i18n/routes';

interface Props {
  libelle: string;
  /** Message affiché après la copie */
  confirmation: string;
  /** Titre de l'aperçu (infobulle et modale) */
  apercu: string;
  /** Texte copié ; {lien} y est remplacé par l'adresse de la version agent */
  prompt: string;
  /** Boutons de la modale */
  confirmer: string;
  annuler: string;
  apparence?: 'plein' | 'contour';
  /** Bord du bouton auquel l'infobulle s'aligne (desktop) */
  alignement?: 'debut' | 'fin';
  /** Emplacement du bouton, transmis à la mesure d'audience */
  emplacement: string;
}

const { libelle, confirmation, apercu, prompt, confirmer, annuler, apparence = 'plein', alignement = 'debut', emplacement } =
  Astro.props;
const chemin = `${fichiersAgents.agentTexte}?src=prompt`;
// Rendu initial avec le domaine de production ; le script le remplace par le domaine consulté
const lien = new URL(chemin, Astro.site ?? 'https://florianbutour.com').href;
const id = `apercu-${emplacement}`;
---

<div
  class:list={['copie-ia', `copie-ia--${alignement}`]}
  data-copie-ia={chemin}
  data-prompt={prompt}
  data-confirmation={confirmation}
  data-emplacement={emplacement}
>
  <Bouton apparence={apparence} aria-describedby={id}>{libelle}</Bouton>
  <span class="copie-ia__apercu copie-ia__boite text-caption" id={id} role="tooltip">
    <span class="copie-ia__titre">{apercu}</span>
    <span class="copie-ia__texte">
      {
        prompt.split('\n').map((ligne) => {
          const [avant, apres] = ligne.split('{lien}');
          return (
            <span class="copie-ia__ligne">
              {avant}
              {apres !== undefined && (
                <>
                  <span data-lien>{lien}</span>
                  {apres}
                </>
              )}
            </span>
          );
        })
      }
    </span>
  </span>
  <dialog class="copie-ia__modale copie-ia__boite text-caption" aria-labelledby={`${id}-titre`}>
    <p class="copie-ia__titre" id={`${id}-titre`}>{apercu}</p>
    <!-- Texte recopié depuis l'infobulle à l'ouverture -->
    <p class="copie-ia__texte"></p>
    <form class="copie-ia__choix" method="dialog">
      <button class="copie-ia__action copie-ia__action--confirmer text-body" value="copier">{confirmer}</button>
      <button class="copie-ia__action text-body" value="annuler">{annuler}</button>
    </form>
  </dialog>
  <span class="copie-ia__statut text-caption" role="status" aria-live="polite"></span>
</div>

<script>
  const survol = matchMedia('(hover: hover)');

  document.querySelectorAll<HTMLElement>('[data-copie-ia]').forEach((copie) => {
    const bouton = copie.querySelector<HTMLButtonElement>(':scope > button');
    const apercu = copie.querySelector<HTMLElement>('.copie-ia__apercu');
    const modale = copie.querySelector('dialog');
    const statut = copie.querySelector<HTMLElement>('.copie-ia__statut');
    if (!bouton || !apercu || !modale || !statut || !navigator.clipboard) return copie.remove();
    const { copieIa = '', prompt = '', confirmation = '', emplacement } = copie.dataset;

    // Adresse complète sur le domaine consulté (le domaine définitif n'est pas encore basculé)
    const lien = new URL(copieIa, location.origin).href;
    apercu.querySelectorAll('[data-lien]').forEach((l) => (l.textContent = lien));
    modale.querySelector('.copie-ia__texte')?.replaceChildren(...apercu.querySelector('.copie-ia__texte')!.cloneNode(true).childNodes);
    const texte = prompt.replaceAll('{lien}', lien);

    let minuterie: number | undefined;
    const copier = async () => {
      try {
        await navigator.clipboard.writeText(texte);
        window.posthog?.capture('agent_copie', { fichier: copieIa, format: 'prompt', emplacement });
        copie.classList.add('copie-ia--masquee');
        statut.textContent = confirmation;
        window.clearTimeout(minuterie);
        minuterie = window.setTimeout(() => (statut.textContent = ''), 4000);
      } catch {}
    };

    // Infobulle : au-dessus du bouton si elle ne tient pas en dessous (et qu'il y a plus de place au-dessus)
    const placer = () => {
      const r = bouton.getBoundingClientRect();
      const entete = Math.max(0, document.querySelector('.navigation')?.getBoundingClientRect().bottom ?? 0);
      const dessous = innerHeight - r.bottom;
      const dessus = r.top - entete;
      const besoin = apercu.offsetHeight + 16;
      copie.classList.toggle('copie-ia--haut', dessous < besoin && dessus > dessous);
    };

    // Ouverte au survol et au focus clavier, refermée par Échap (WCAG 1.4.13)
    const reafficher = () => copie.classList.remove('copie-ia--masquee');
    copie.addEventListener('pointerenter', placer);
    copie.addEventListener('pointerleave', reafficher);
    bouton.addEventListener('focus', () => (placer(), reafficher()));
    bouton.addEventListener('blur', reafficher);
    bouton.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') copie.classList.add('copie-ia--masquee');
    });

    bouton.addEventListener('click', () => {
      // Sans survol, rien n'a encore été montré : la modale montre le texte et demande confirmation
      if (!survol.matches) return modale.showModal();
      copier();
    });

    // La modale se ferme par ses boutons (form method="dialog"), par Échap ou par un toucher à côté
    modale.addEventListener('click', (e) => {
      if (e.target === modale) modale.close('annuler');
    });
    modale.addEventListener('close', () => {
      if (modale.returnValue === 'copier') copier();
      modale.returnValue = '';
    });
  });
</script>

<style>
  .copie-ia {
    position: relative;
    display: inline-flex;
  }

  /* Sans JavaScript, rien à copier */
  :global(html:not(.js)) .copie-ia {
    display: none;
  }

  /* Infobulle et modale (Figma 111:5507) : fond gris, filet et ombre portée nets */
  .copie-ia__boite {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    width: 30rem;
    max-width: calc(100vw - 2 * var(--layout-gutter));
    padding: 1.5rem;
    border: 1px solid var(--color-border-ink);
    background: var(--color-background-subtle);
    box-shadow: 4px 4px 0 var(--color-border-ink);
    color: var(--color-text-secondary);
    text-align: left;
    white-space: normal;
    overflow-wrap: anywhere;
  }

  .copie-ia__titre {
    color: var(--color-text-primary);
    font-weight: 500;
  }

  .copie-ia__ligne {
    display: block;
  }

  /* ---------- Infobulle ---------- */
  .copie-ia__apercu {
    position: absolute;
    z-index: 4;
    top: calc(100% + 0.75rem);
    left: 0;
    visibility: hidden;
    opacity: 0;
    transition:
      opacity var(--motion-duration) var(--motion-ease),
      visibility 0s var(--motion-duration);
  }

  /* Pont invisible entre le bouton et l'infobulle : le pointeur peut s'y rendre sans la fermer */
  .copie-ia__apercu::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    bottom: 100%;
    height: 0.75rem;
  }

  /* Pas assez de place sous le bouton : au-dessus */
  .copie-ia--haut .copie-ia__apercu {
    top: auto;
    bottom: calc(100% + 0.75rem);
  }

  .copie-ia--haut .copie-ia__apercu::before {
    top: 100%;
    bottom: auto;
  }

  .copie-ia:has(:focus-visible):not(.copie-ia--masquee) .copie-ia__apercu {
    visibility: visible;
    opacity: 1;
    transition: opacity var(--motion-duration) var(--motion-ease);
  }

  @media (hover: hover) {
    .copie-ia:hover:not(.copie-ia--masquee) .copie-ia__apercu {
      visibility: visible;
      opacity: 1;
      transition: opacity var(--motion-duration) var(--motion-ease);
    }
  }

  /* Desktop : l'infobulle peut s'aligner sur le bord droit du bouton (hero, boutons à droite) */
  @media (min-width: 64rem) {
    .copie-ia--fin .copie-ia__apercu {
      left: auto;
      right: 0;
    }
  }

  /* ---------- Modale (sans survol) ---------- */
  .copie-ia__modale {
    margin: auto;
    gap: 1rem;
    max-height: calc(100dvh - 2 * var(--layout-gutter));
    overflow-y: auto;
  }

  .copie-ia__modale:not([open]) {
    display: none;
  }

  .copie-ia__modale::backdrop {
    background: rgb(13 13 13 / 0.4);
  }

  .copie-ia__choix {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 0.5rem;
  }

  /* Confirmer en aplat bleu, annuler au filet : les deux états du bouton plein, sur fond clair */
  .copie-ia__action {
    padding: 0.75rem 1.25rem;
    border: 0;
    background: var(--color-background-canvas);
    box-shadow: inset 0 0 0 1px var(--color-border-ink);
    color: var(--color-text-primary);
    cursor: pointer;
  }

  .copie-ia__action--confirmer {
    background: var(--color-background-brand);
    box-shadow: none;
    color: var(--color-text-inverse);
  }

  /* Sous le bouton, hors du flux : la rangée de boutons ne bouge pas */
  .copie-ia__statut {
    position: absolute;
    top: calc(100% + 0.5rem);
    left: 0;
    width: max-content;
    max-width: calc(100vw - 2 * var(--layout-gutter));
  }

  /* Boutons susceptibles de passer à la ligne : infobulle et message se placent sous toute la rangée */
  @media (max-width: 63.99rem) {
    .copie-ia {
      position: static;
    }
  }
</style>
