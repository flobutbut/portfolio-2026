---
/**
 * Entrée d'écrit (Figma 2:491)
 * Titre, thèse et strates touchées en bandeaux horizontaux. Toute la ligne mène à l'écrit.
 * Survol : voir « Entrées de liste » dans global.css.
 */
import StratesTouchees from './StratesTouchees.astro';
import type { Locale } from '../i18n/routes';
import type { Strates } from '../lib/strates';

interface Props {
  locale: Locale;
  titre: string;
  these: string;
  strates: Strates;
  href: string;
  niveau?: 2 | 3;
}

const { locale, titre, these, strates, href, niveau = 3 } = Astro.props;
const Titre = `h${niveau}` as 'h2' | 'h3';
---

<article class="entree entree-ecrit">
  <div class="entree-ecrit__texte">
    <Titre class="text-heading-24">
      <a class="entree-ecrit__lien" href={href}>{titre}</a>
    </Titre>
    <p class="entree-ecrit__these text-body">{these}</p>
  </div>
  <StratesTouchees locale={locale} strates={strates} orientation="horizontale" />
</article>

<style>
  .entree-ecrit {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: 2.75rem;
    padding-left: var(--layout-offset);
    border-bottom: 1px solid var(--color-border-default);
  }

  .entree-ecrit__texte {
    display: flex;
    flex-direction: column;
    gap: 0.125rem;
    max-width: 50rem;
  }

  .entree-ecrit__lien {
    text-decoration: none;
  }

  .entree-ecrit__lien::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .entree-ecrit__these {
    color: var(--color-text-secondary);
  }

  @media (max-width: 63.99rem) {
    .entree-ecrit {
      padding-left: 0;
    }
  }

  @media (max-width: 39.99rem) {
    .entree-ecrit {
      padding-block: 2rem;
    }
  }
</style>
