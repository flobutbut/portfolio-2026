---
/**
 * Strates/Bouton (Figma 2:493, 8:480)
 * Deux apparences : « plein » (fond clair) et « contour » (pour les surfaces foncées).
 * Survol : un aplat balaie le bouton depuis son bord gauche (le « Trigger » Figma, 1 px au repos).
 * Rendu en <a> si `href` est fourni, en <button> sinon.
 */
import type { HTMLAttributes } from 'astro/types';

type Props = {
  apparence?: 'plein' | 'contour';
  href?: string;
} & Omit<HTMLAttributes<'a'> & HTMLAttributes<'button'>, 'class'>;

const { apparence = 'plein', href, ...attrs } = Astro.props;
const Tag = href ? 'a' : 'button';
---

<Tag class:list={['bouton', 'text-body', `bouton--${apparence}`]} href={href} type={href ? undefined : 'button'} {...attrs}>
  <span class="bouton__libelle"><slot /></span>
</Tag>

<style>
  .bouton {
    position: relative;
    isolation: isolate;
    display: inline-flex;
    align-items: center;
    padding: 1rem 1.5rem;
    border: 0;
    white-space: pre;
    text-decoration: none;
    cursor: pointer;
    transition: color var(--motion-duration) var(--motion-ease);
  }

  .bouton::before {
    content: '';
    position: absolute;
    z-index: -1;
    inset-block: 0;
    left: 0;
    width: 1px;
    transition: width var(--motion-duration) var(--motion-ease);
  }

  .bouton--plein {
    background: var(--color-background-canvas);
    color: var(--color-text-primary);
  }

  .bouton--plein::before {
    background: var(--color-background-brand);
  }

  .bouton--contour {
    background: none;
    color: var(--color-text-inverse);
    box-shadow: inset 0 0 0 1.5px var(--color-border-white);
  }

  .bouton--contour::before {
    width: 0;
    background: var(--color-background-canvas);
  }

  @media (hover: hover) {
    .bouton:hover::before {
      width: 100%;
    }

    .bouton--plein:hover {
      color: var(--color-text-inverse);
    }

    .bouton--contour:hover {
      color: var(--color-text-primary);
    }
  }
</style>
