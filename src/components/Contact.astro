---
/**
 * Strates/Contact (Figma 2:492), pied de page
 * Adresse en grand dans la colonne de 1 120 px, filet, puis signature, liens et localisation
 * sur toute la largeur. Sur la page Contact, l'adresse est déjà dans la page : `avecEmail={false}`.
 */
import EmailCopiable from './EmailCopiable.astro';
import type { Locale } from '../i18n/routes';
import { path } from '../i18n/routes';
import { getInterface } from '../i18n/ui';
import { isTodo } from '../lib/todo';

interface Props {
  locale: Locale;
  avecEmail?: boolean;
}

const { locale, avecEmail = true } = Astro.props;
const { contact } = await getInterface(locale);

const liens = [
  { libelle: contact.linkedin.libelle, url: contact.linkedin.url, externe: true },
  { libelle: contact.cv.libelle, url: contact.cv.url, externe: false },
  { libelle: contact.ecrits, url: path('ecrits', locale), externe: false },
];
---

<footer id="contact" class="contact" aria-labelledby="contact-titre">
  <h2 id="contact-titre" class="visually-hidden">{contact.titre}</h2>
  {
    avecEmail && (
      <div class="contact__email">
        <div class="container container--etroit">
          <EmailCopiable locale={locale} />
        </div>
      </div>
    )
  }
  <div class="contact__meta text-caption">
    <p class="contact__col">{contact.signature}</p>
    <p class="contact__col contact__col--centre">
      {
        liens.map((lien, i) => (
          <>
            {i > 0 && <span aria-hidden="true"> · </span>}
            {isTodo(lien.url) ? (
              <span class="todo" title={lien.url}>
                {lien.libelle}
              </span>
            ) : (
              <a href={lien.url} rel={lien.externe ? 'me noopener' : undefined}>
                {lien.libelle}
              </a>
            )}
          </>
        ))
      }
    </p>
    <p class="contact__col contact__col--fin">{contact.localisation}</p>
  </div>
</footer>

<style>
  .contact {
    background: var(--color-background-inverse);
    color: var(--color-text-inverse);
  }

  .contact__email {
    padding-top: 4.5rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--color-border-on-dark);
  }

  .contact__meta {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.5rem 2rem;
    color: var(--color-text-on-dark-muted);
  }

  .contact__col {
    flex: 1 0 0;
  }

  .contact__col--centre {
    text-align: center;
  }

  .contact__col--fin {
    text-align: right;
  }

  .contact__meta a {
    text-decoration: none;
  }

  .contact__meta a:hover {
    color: var(--color-text-inverse);
    text-decoration: underline;
  }

  .contact__meta .todo {
    color: var(--color-text-on-dark-muted);
  }

  @media (max-width: 39.99rem) {
    .contact__email {
      padding-top: 3rem;
      padding-bottom: 3rem;
    }

    .contact__meta {
      flex-direction: column;
      gap: 0.75rem;
      padding-inline: var(--layout-gutter);
    }

    .contact__col--centre,
    .contact__col--fin {
      text-align: left;
    }
  }
</style>
