---
/**
 * Planche/Contact (Figma 27:412) : « Ce que je cherche », juste avant le pied de page.
 * Le libellé n'apparaît que sur les pages de cas, d'écrit et de parcours (comme dans les maquettes).
 */
import type { Locale } from '../i18n/routes';
import { getInterface } from '../i18n/ui';

interface Props {
  locale: Locale;
  libelle?: boolean;
}

const { locale, libelle = true } = Astro.props;
const { planche } = await getInterface(locale);
---

<section class="planche" aria-labelledby="planche-titre">
  <div class="container container--etroit planche__inner">
    {libelle && <p class="text-label libelle planche__libelle">{planche.libelle}</p>}
    <h2 id="planche-titre" class="text-heading-40 planche__titre">
      {planche.titre.map((ligne) => <span>{ligne}</span>)}
    </h2>
    <div class="planche__texte">
      {planche.texte.map((p) => <p class="text-lead">{p}</p>)}
    </div>
  </div>
</section>

<style>
  .planche__inner {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding-block: 8rem;
  }

  .planche__libelle {
    padding-bottom: 0.5rem;
  }

  .planche__titre,
  .planche__texte {
    max-width: 45rem;
  }

  .planche__titre span {
    display: block;
  }

  .planche__texte {
    display: flex;
    flex-direction: column;
    gap: 1.875rem;
    color: var(--color-text-secondary);
  }

  @media (max-width: 39.99rem) {
    .planche__inner {
      padding-block: 4rem;
    }
  }
</style>
