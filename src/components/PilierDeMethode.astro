---
/**
 * Strates/Pilier de méthode (Figma 2:490)
 * Un titre, une phrase et les pratiques associées, en bandeaux On.
 */
import Strate from './Strate.astro';

interface Props {
  titre: string;
  description: string;
  pratiques: string[];
  /** Niveau du titre dans la page. */
  niveau?: 2 | 3;
}

const { titre, description, pratiques, niveau = 3 } = Astro.props;
const Titre = `h${niveau}` as 'h2' | 'h3';
---

<div class="pilier">
  <div class="pilier__texte">
    <Titre class="text-heading-40">{titre}</Titre>
    <p class="pilier__description text-body">{description}</p>
  </div>
  {
    pratiques.length > 0 && (
      <ul class="pilier__pratiques" role="list">
        {pratiques.map((pratique) => (
          <li>
            <Strate>{pratique}</Strate>
          </li>
        ))}
      </ul>
    )
  }
</div>

<style>
  .pilier {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 1rem;
    padding-block: 1.5rem;
    border-bottom: 1px solid var(--color-border-default);
  }

  .pilier__description {
    color: var(--color-text-secondary);
  }

  .pilier__pratiques {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    width: var(--layout-strates-width);
    max-width: 100%;
    padding: 0;
    list-style: none;
  }
</style>
