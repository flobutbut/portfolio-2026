---
import type { GetStaticPaths } from 'astro';
import Ecrit from '../../../gabarits/Ecrit.astro';
import { lister } from '../../../lib/contenu';

export const getStaticPaths = (async () => {
  const elements = await lister('ecrits', 'en');
  return elements.map((element) => ({ params: { slug: element.slug }, props: { element } }));
}) satisfies GetStaticPaths;

const { element } = Astro.props;
---

<Ecrit locale="en" ecrit={element} />
