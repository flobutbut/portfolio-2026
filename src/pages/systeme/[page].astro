---
/**
 * Banc d'essai des composants, en développement seulement : /systeme/composants
 * Aucune page n'est générée en production.
 * Les textes sont ceux des exemples de la page « Composants » de Figma.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import Bouton from '../../components/Bouton.astro';
import Strate from '../../components/Strate.astro';
import EnTeteDeSection from '../../components/EnTeteDeSection.astro';
import PilierDeMethode from '../../components/PilierDeMethode.astro';
import EntreeDeProjet from '../../components/EntreeDeProjet.astro';
import EntreeDEcrit from '../../components/EntreeDEcrit.astro';

export function getStaticPaths() {
  return import.meta.env.DEV ? [{ params: { page: 'composants' } }] : [];
}

const projet = {
  titre: 'Unifier des logiciels métiers en une plateforme',
  description: 'Une architecture par profils sur un socle de données commun, tenue par un design system gouverné.',
  meta: 'Desoutter · Plateforme SaaS industrielle',
  strates: { surfaces: true, designSystem: true, modele: false },
  href: '#',
};
---

<BaseLayout title="Composants · banc d'essai" locale="fr">
  <div class="container banc">
    <EnTeteDeSection titre="Composants" niveau={1} />

    <section>
      <h2 class="text-label banc__legende">01 · Bouton</h2>
      <div class="banc__rangee">
        <Bouton href="#">Voir les travaux ↓</Bouton>
        <Bouton>CV</Bouton>
      </div>
      <div class="banc__rangee banc__rangee--sombre">
        <Bouton apparence="contour" href="#">Voir les travaux ↓</Bouton>
        <Bouton apparence="plein" href="#">Voir les travaux ↓</Bouton>
      </div>
    </section>

    <section>
      <h2 class="text-label banc__legende">02 · Strate</h2>
      <div class="banc__strates">
        <Strate>interfaces</Strate>
        <Strate etat={false}>interfaces</Strate>
      </div>
    </section>

    <section>
      <h2 class="text-label banc__legende">04 · En-tête de section</h2>
      <EnTeteDeSection titre="Méthode" />
    </section>

    <section>
      <h2 class="text-label banc__legende">05 · Entrée de projet</h2>
      <EntreeDeProjet locale="fr" {...projet} />
      <EntreeDeProjet locale="fr" {...projet} visuel={{ alt: '' }} />
    </section>

    <section>
      <h2 class="text-label banc__legende">06 · Pilier de méthode</h2>
      <PilierDeMethode
        titre="Cadrer"
        description="J’étudie les usages sur le terrain, puis je cadre les arbitrages avec Product et Engineering avant que les règles se figent."
        pratiques={['Entretiens et observation terrain', 'Tests d’utilisabilité', 'Cartographie des parcours', 'Arbitrages produit']}
      />
    </section>

    <section>
      <h2 class="text-label banc__legende">07 · Entrée d’écrit</h2>
      <EntreeDEcrit
        locale="fr"
        titre="Concevoir, c’est retirer"
        these="Un système bien conçu absorbe l’écart entre ce qu’on lui donne et ce dont on a besoin."
        strates={{ surfaces: false, designSystem: false, modele: false }}
        href="#"
      />
    </section>
  </div>
</BaseLayout>

<style>
  .banc {
    display: flex;
    flex-direction: column;
    gap: 5rem;
    padding-block: 5rem;
  }

  .banc__legende {
    margin-bottom: 1.5rem;
    color: var(--color-text-muted);
  }

  .banc__rangee {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1.5rem;
    background: var(--color-surface-inactive);
  }

  .banc__rangee--sombre {
    background: var(--color-background-inverse);
  }

  .banc__strates {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    width: var(--layout-strates-width);
  }
</style>
