---
/**
 * Accueil (Figma 1:14 « C · Accueil — Les strates »)
 * Hero · Strates · Travaux · Position · Méthode · Écrits
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import Bouton from '../components/Bouton.astro';
import EnTeteDeSection from '../components/EnTeteDeSection.astro';
import EntreeDeProjet from '../components/EntreeDeProjet.astro';
import EntreeDEcrit from '../components/EntreeDEcrit.astro';
import PilierDeMethode from '../components/PilierDeMethode.astro';
import FigureMethode from '../components/FigureMethode.astro';
import { fichiersAgents, otherLocale, path, type Locale } from '../i18n/routes';
import { getInterface } from '../i18n/ui';
import { getAccueil, lister } from '../lib/contenu';
import { STRATES } from '../lib/strates';
import { isTodo } from '../lib/todo';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = await getInterface(locale);
const a = await getAccueil(locale);
const cas = await lister('cas', locale);
const ecrits = await lister('ecrits', locale);
const cv = ui.contact.cv.url;
// Bloc « Pour les agents » : l'adresse affichée sans protocole, copiée en entier
const agent = new URL(fichiersAgents.agent, Astro.site ?? 'https://florianbutour.com');
---

<BaseLayout title={a.titrePage} description={a.description} locale={locale} alternate={path('accueil', otherLocale(locale))}>
  <!-- Hero : trois strates -->
  <section class="hero" aria-labelledby="hero-titre">
    <div class="hero__haut">
      <div class="hero__surface">
        <p class="text-label libelle">{a.hero.surtitre}</p>
        <h1 id="hero-titre" class="text-display">{a.hero.accroche}</h1>
      </div>
      <div class="hero__marque">
        <p class="text-lead">{a.hero.complement}</p>
      </div>
    </div>
    <div class="hero__socle">
      <div class="hero__identite text-lead">
        <p><strong>{a.hero.nom}</strong>, {a.hero.fonction}</p>
        <p>{a.hero.details}</p>
      </div>
      <div class="hero__actions">
        {cas.length > 0 && <Bouton href="#travaux">{a.hero.voirTravaux}</Bouton>}
        {isTodo(cv) ? <span class="bouton-todo todo text-body" title={cv}>{a.hero.cv}</span> : <Bouton apparence="contour" href={cv}>{a.hero.cv}</Bouton>}
      </div>
    </div>
  </section>

  <!-- Strates -->
  <section class="container section" aria-labelledby="strates-titre" data-apparition>
    <EnTeteDeSection titre={a.strates.titre} id="strates-titre" />
    <div class="strates__intro">
      <p class="text-lead">{a.strates.introduction}</p>
    </div>
    <ul class="strates__cartes" role="list">
      {
        STRATES.map((cle) => (
          <li class="strates__carte">
            <h3 class="strates__nom text-heading-24">{ui.strates[cle]}</h3>
            <p class="text-body">{a.strates[cle].description}</p>
            <p class="text-caption libelle">{a.strates[cle].exemples}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <!-- Travaux (masqué tant qu'aucun cas n'est publié) -->
  {
    cas.length > 0 && (
      <section id="travaux" class="container section" aria-labelledby="travaux-titre" data-apparition>
        <EnTeteDeSection titre={a.travaux.titre} id="travaux-titre" />
        <div>
          {
            cas.map((c) => (
              <EntreeDeProjet
                locale={locale}
                lang={c.langue !== locale ? c.langue : undefined}
                titre={c.data.entree?.titre ?? c.data.titre}
                description={c.data.entree?.description ?? c.data.chapo}
                meta={c.data.meta}
                strates={c.data.strates}
                href={c.href}
              />
            ))
          }
        </div>
      </section>
    )
  }

  <!-- Position -->
  <section class="position" aria-labelledby="position-titre" data-apparition>
    <div class="container position__inner">
      <p class="text-label position__libelle">{a.position.libelle}</p>
      <div class="position__texte">
        <h2 id="position-titre" class="text-display">{a.position.titre}</h2>
        <p class="text-body">{a.position.texte}</p>
        <!-- Pour les agents (Figma 94:685) -->
        <div class="agents">
          <h3 class="text-label">{a.position.agents.libelle}</h3>
          <p class="text-body">{a.position.agents.texte}</p>
          <div class="agents__actions">
            <p class="agents__adresse text-heading-24">{agent.host}{agent.pathname}</p>
            <span class="agents__copier" data-copie={agent.href} data-copie-ok={a.position.agents.copie}>
              <Bouton>{a.position.agents.copier}</Bouton>
            </span>
            <Bouton apparence="contour" href={fichiersAgents.agent} hreflang="fr">{a.position.agents.lire}</Bouton>
            <p class="agents__statut text-caption" role="status" aria-live="polite"></p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Méthode -->
  <section class="container section methode" aria-labelledby="methode-titre" data-methode>
    <EnTeteDeSection titre={a.methode.titre} id="methode-titre" />
    <div class="methode__grille">
      {
        a.methode.piliers.map((p, i) => (
          <>
            <div class="methode__pilier" style={`--rang: ${i + 1}`} data-pilier={i}>
              <PilierDeMethode titre={p.titre} description={p.description} pratiques={p.pratiques} />
            </div>
            <div class="methode__figure" style={`--rang: ${i + 1}`} data-figure={i}>
              <FigureMethode {...p.figure} id={`fig-methode-${i}`} />
            </div>
          </>
        ))
      }
    </div>
  </section>

  <!-- Écrits (masqués tant qu'aucun écrit n'est publié) -->
  {
    ecrits.length > 0 && (
      <section class="container section" aria-labelledby="ecrits-titre" data-apparition>
        <EnTeteDeSection titre={a.ecrits.titre} id="ecrits-titre" />
        <div class="ecrits__liste">
          {
            ecrits.map((e) => (
              <EntreeDEcrit
                locale={locale}
                lang={e.langue !== locale ? e.langue : undefined}
                titre={e.data.titre}
                these={e.data.these}
                strates={e.data.strates}
                href={e.href}
              />
            ))
          }
        </div>
      </section>
    )
  }
</BaseLayout>

<script>
  import { initMethode } from '../scripts/methode';
  initMethode();

  // Pour les agents : copie l'adresse de /agent.md ; sans presse-papiers, le bouton disparaît
  document.querySelectorAll<HTMLElement>('[data-copie]').forEach((copier) => {
    const bouton = copier.querySelector('button');
    const statut = copier.closest('.agents')?.querySelector<HTMLElement>('.agents__statut');
    if (!bouton || !statut || !navigator.clipboard) return copier.remove();
    let minuterie: number | undefined;
    bouton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copier.dataset.copie ?? '');
        statut.textContent = copier.dataset.copieOk ?? '';
        window.clearTimeout(minuterie);
        minuterie = window.setTimeout(() => (statut.textContent = ''), 2400);
      } catch {}
    });
  });
</script>

<style>
  /* ---------- Hero ---------- */
  /* Navigation + hero = hauteur de l'écran (au minimum) : le bloc blanc et bleu absorbe l'espace */
  /* --bord : retrait aligné sur la colonne de contenu (1 440 px max).
     Calculé sur la largeur du hero (unités cqw), pas sur celle de chaque colonne. */
  .hero {
    container-type: inline-size;
    --bord: max(var(--layout-gutter), calc((100cqw - var(--layout-max)) / 2 + var(--layout-gutter)));
    display: flex;
    flex-direction: column;
    min-height: calc(100svh - var(--layout-nav-height));
  }

  .hero__haut {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 996fr) minmax(0, 444fr);
  }

  .hero__surface {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 8.5rem var(--layout-gutter) 3rem var(--bord);
  }

  .hero__surface h1 {
    max-width: 55.25rem;
  }

  .hero__marque {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 2rem var(--bord) 2rem var(--layout-gutter);
    background: var(--color-background-brand);
    color: var(--color-text-inverse);
  }


  .hero__socle {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 2rem var(--bord);
    background: var(--color-background-inverse);
    color: var(--color-text-inverse);
  }

  .hero__identite strong {
    font-weight: 500;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .bouton-todo {
    padding: 1rem 1.5rem;
    box-shadow: inset 0 0 0 2px var(--color-border-on-dark);
    color: var(--color-text-on-dark-muted);
  }

  @media (max-width: 63.99rem) {
    .hero__haut {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: 1fr auto;
    }

    .hero__surface {
      padding-top: 5rem;
    }

    .hero__marque {
      padding-left: var(--bord);
    }

    .hero__socle {
      flex-direction: column;
      align-items: flex-start;
    }
  }

  /* ---------- Sections ---------- */
  .section {
    padding-top: 8.75rem;
    padding-bottom: 2.5rem;
  }


  @media (max-width: 39.99rem) {
    .section {
      padding-top: 5rem;
    }
  }

  /* ---------- Strates ---------- */
  /* Introduction sur fond background/subtle, alignée sur le texte des cartes */
  .strates__intro {
    margin-bottom: 2rem;
    padding: 1.5rem 2rem;
    background: var(--color-background-subtle);
  }

  .strates__intro p {
    max-width: 52.5rem;
  }

  .strates__cartes {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    padding: 0 0 2rem;
    list-style: none;
  }

  .strates__carte {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    padding: 2rem;
    border: 1px solid var(--color-border-default);
  }

  .strates__carte + .strates__carte {
    border-left: 0;
  }

  .strates__nom {
    padding: 0.375rem 0.5rem;
    background: var(--color-background-brand);
    color: var(--color-text-inverse);
  }

  @media (max-width: 63.99rem) {
    .strates__cartes {
      grid-template-columns: minmax(0, 1fr);
    }

    .strates__carte + .strates__carte {
      border-left: 1px solid var(--color-border-default);
      border-top: 0;
    }
  }

  /* ---------- Position ---------- */
  .position {
    margin-top: 6.25rem;
    background: var(--color-background-brand);
    color: var(--color-text-inverse);
  }

  .position__inner {
    display: grid;
    grid-template-columns: 18.75rem minmax(0, 1fr);
    gap: 0.5rem;
    padding-top: 7.5rem;
    padding-bottom: 7rem;
  }

  .position__texte {
    display: flex;
    flex-direction: column;
    gap: 2.25rem;
  }

  .position__texte p {
    max-width: 38.75rem;
    color: var(--color-text-on-brand-secondary);
  }

  .agents {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    padding-top: 2rem;
    border-top: 1px solid var(--color-border-white);
  }

  .agents h3 {
    font-weight: 400;
  }

  .agents__actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    padding-top: 0.5rem;
  }

  .position__texte .agents__adresse {
    color: var(--color-text-inverse);
    overflow-wrap: anywhere;
  }

  /* Sans JavaScript, rien à copier : l'adresse reste lisible et le fichier accessible */
  :global(html:not(.js)) .agents__copier {
    display: none;
  }

  .position__texte .agents__statut {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: 0;
  }

  @media (max-width: 39.99rem) {
    .agents__actions {
      gap: 1rem;
    }

    .agents__adresse {
      flex-basis: 100%;
    }
  }

  @media (max-width: 63.99rem) {
    .position__inner {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
      padding-block: 5rem;
    }
  }

  /* ---------- Méthode ---------- */
  .methode__grille {
    display: grid;
    grid-template-columns: minmax(0, 488fr) minmax(0, 800fr);
    column-gap: 2.5rem;
    padding-block: 2.75rem;
    border-bottom: 1px solid var(--color-border-default);
  }

  .methode__pilier {
    grid-column: 1;
    grid-row: var(--rang);
  }

  /* Sans JavaScript : chaque figure en face de son pilier */
  .methode__figure {
    grid-column: 2;
    grid-row: var(--rang);
    padding-block: 1.5rem;
  }

  @media (max-width: 63.99rem) {
    .methode__grille {
      grid-template-columns: minmax(0, 1fr);
    }

    .methode__pilier,
    .methode__figure {
      grid-column: 1;
      grid-row: auto;
    }
  }

  /* Avec JavaScript, desktop, sans prefers-reduced-motion : figure collée (voir scripts/methode.ts) */
  .methode--collee .methode__figure {
    grid-row: 1 / span 3;
    position: sticky;
    top: max(1.5rem, calc(50svh - 20rem));
    align-self: start;
    opacity: 0;
    transform: translateY(0.75rem);
    transition:
      opacity var(--motion-duration-long) var(--motion-ease),
      transform var(--motion-duration-long) var(--motion-ease);
  }

  .methode--collee .methode__figure[data-actif] {
    opacity: 1;
    transform: none;
  }

  /* Chaque pilier occupe une bonne part d'écran : la figure a le temps de rester collée */
  .methode--collee .methode__pilier {
    display: flex;
    flex-direction: column;
    justify-content: center;
    min-height: 70svh;
  }

  /* Les piliers inactifs s'estompent en restant lisibles (AA) : seuls les textes passent en gris,
     les étiquettes de strate ne bougent pas (elles ne sont pas interactives) */
  .methode--collee .methode__pilier :global(:is(h3, p)) {
    transition: color var(--motion-duration-long) var(--motion-ease);
  }

  .methode--collee .methode__pilier:not([data-actif]) :global(:is(h3, p)) {
    color: var(--color-text-muted);
  }

  /* Écrits : pleine largeur comme les travaux, le retrait est porté par le composant */
  .ecrits__liste {
    padding-top: 3rem;
  }
</style>
