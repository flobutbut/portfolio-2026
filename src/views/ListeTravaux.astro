---
/** Liste des travaux (Figma 9:1314) : entrées avec visuel, conteneur de 1 120 px. */
import BaseLayout from '../layouts/BaseLayout.astro';
import EnTeteDeSection from '../components/EnTeteDeSection.astro';
import EntreeDeProjet from '../components/EntreeDeProjet.astro';
import PlancheContact from '../components/PlancheContact.astro';
import { otherLocale, path, type Locale } from '../i18n/routes';
import { getInterface } from '../i18n/ui';
import { lister } from '../lib/contenu';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = await getInterface(locale);
const cas = await lister('cas', locale);
---

<BaseLayout title={ui.navigation.travaux} description={ui.metadonnees.travaux} locale={locale} alternate={path('travaux', otherLocale(locale))}>
  <div class="container container--etroit page-tete">
    <EnTeteDeSection titre={ui.navigation.travaux} niveau={1} espace="page" />
  </div>
  <div class="container container--etroit liste" data-apparition>
    {
      cas.map((c) => (
        <EntreeDeProjet
          locale={locale}
          lang={c.langue !== locale ? c.langue : undefined}
          niveau={2}
          titre={c.data.entree?.titre ?? c.data.titre}
          description={c.data.entree?.description ?? c.data.chapo}
          meta={c.data.meta}
          strates={c.data.strates}
          href={c.href}
          visuel={c.data.visuel ?? { alt: '' }}
        />
      ))
    }
  </div>
  <PlancheContact locale={locale} libelle={false} />
</BaseLayout>

<style>
  .liste {
    padding-top: 0.5rem;
  }
</style>
