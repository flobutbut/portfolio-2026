---
/**
 * Page Contact (Figma 54:671)
 * Titre, puis planche sombre : message, adresse en grand copiable, filet.
 * Le pied de page n'y répète pas l'adresse.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import EmailCopiable from '../components/EmailCopiable.astro';
import EnTeteDeSection from '../components/EnTeteDeSection.astro';
import { otherLocale, path, type Locale } from '../i18n/routes';
import { getInterface } from '../i18n/ui';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const ui = await getInterface(locale);
---

<BaseLayout
  title={ui.navigation.contact}
  description={ui.metadonnees.contact}
  locale={locale}
  alternate={path('contact', otherLocale(locale))}
  piedAvecEmail={false}
>
  <div class="container container--etroit page-tete">
    <EnTeteDeSection titre={ui.navigation.contact} niveau={1} espace="page" filet={false} />
  </div>

  <section class="planche-sombre" aria-labelledby="contact-message">
    <div class="container container--etroit planche-sombre__inner">
      <div class="planche-sombre__message">
        <h2 id="contact-message" class="text-heading-40">
          {ui.planche.titre.map((ligne) => <span>{ligne}</span>)}
        </h2>
        <div class="planche-sombre__texte">
          {ui.planche.texte.map((p) => <p class="text-lead">{p}</p>)}
        </div>
      </div>
      <div class="planche-sombre__email">
        <EmailCopiable locale={locale} />
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  /* La planche sombre rejoint le pied de page, même sur une page plus courte que l'écran */
  :global(main:has(.planche-sombre)) {
    display: flex;
    flex-direction: column;
  }

  .planche-sombre {
    flex: 1;
    background: var(--color-background-inverse);
    color: var(--color-text-inverse);
  }

  .planche-sombre__inner {
    display: flex;
    flex-direction: column;
    gap: 3rem;
    padding-top: 3.5rem;
  }

  .planche-sombre__message {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    max-width: 45rem;
  }

  .planche-sombre__message h2 span {
    display: block;
  }

  .planche-sombre__texte {
    display: flex;
    flex-direction: column;
    gap: 1.875rem;
  }

  .planche-sombre__email {
    padding-top: 4.5rem;
    padding-bottom: 4rem;
    border-bottom: 1px solid var(--color-border-on-dark);
  }

  @media (max-width: 39.99rem) {
    .planche-sombre__email {
      padding-top: 3rem;
      padding-bottom: 3rem;
    }
  }
</style>
