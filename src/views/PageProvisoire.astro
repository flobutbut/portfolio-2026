---
/**
 * Gabarit provisoire de l'étape 2 : seul le titre de section s'affiche.
 * Remplacé par les vrais gabarits à l'étape 4.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { otherLocale, path, type Locale, type RouteKey } from '../i18n/routes';
import { getInterface } from '../i18n/ui';

interface Props {
  locale: Locale;
  page: RouteKey;
}

const { locale, page } = Astro.props;
const ui = await getInterface(locale);
const titre = page === 'accueil' ? 'Florian Butour' : ui.navigation[page];
---

<BaseLayout title={titre} locale={locale} alternate={path(page, otherLocale(locale))}>
  <div class="container provisoire">
    <h1 class:list={['text-display', { 'visually-hidden': page === 'accueil' }]}>{titre}</h1>
  </div>
</BaseLayout>

<style>
  .provisoire {
    padding-block: 8.75rem;
  }
</style>
